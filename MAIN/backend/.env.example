# ==============================================================================
# Swarmly Backend Environment Variables
# Copy this file to .env for local development:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Configuration
# Required for PostgreSQL persistence and JWT token verification.
# Obtain from your Supabase Project Dashboard -> Settings -> API.
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder

# Alternatively, the backend will also read frontend-compatible variable names:
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder

# ------------------------------------------------------------------------------
# Supabase JWT Secret (Optional / Legacy HS256)
# Used for symmetric HS256 JWT signature verification.
# For modern Supabase projects using asymmetric ES256, the backend automatically
# resolves and verifies public keys via the project's JWKS endpoint.
# ------------------------------------------------------------------------------
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-placeholder

# ------------------------------------------------------------------------------
# Database Operating Mode (Optional)
# Options:
#   auto       - Connects to Supabase when configured, or test mode during pytest
#   production - Enforces live Supabase PostgREST calls with strict RLS
#   test       - Uses isolated in-memory test database for fast unit testing
# ------------------------------------------------------------------------------
SUPABASE_MODE=auto
