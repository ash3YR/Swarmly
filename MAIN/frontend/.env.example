# ==============================================================================
# Swarmly Frontend Environment Variables
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Configuration (Required for Cloud Projects, Workflows & Auth)
# Obtain these from your Supabase Project Settings -> API.
# Note: NEXT_PUBLIC_ variables are bundled into the browser client and must only
# use the public anon/publishable key. NEVER expose the service_role key here.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder

# ------------------------------------------------------------------------------
# Backend API Base URL (Optional)
# Defaults to http://localhost:8000 if not specified.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
